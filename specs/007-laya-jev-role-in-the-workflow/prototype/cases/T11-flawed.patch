diff --git a/src/test/java/com/example/samplecrm/ContactSearchApiTest.java b/src/test/java/com/example/samplecrm/ContactSearchApiTest.java
new file mode 100644
index 0000000..2d69a83
--- /dev/null
+++ b/src/test/java/com/example/samplecrm/ContactSearchApiTest.java
@@ -0,0 +1,86 @@
+package com.example.samplecrm;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.util.List;
+import java.util.Map;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.CsvSource;
+import org.springframework.core.ParameterizedTypeReference;
+import org.springframework.http.HttpMethod;
+import org.springframework.test.web.servlet.client.RestTestClient.ResponseSpec;
+
+class ContactSearchApiTest extends ApiTestBase {
+
+    private static final ParameterizedTypeReference<List<Map<String, Object>>> LIST =
+            new ParameterizedTypeReference<>() {};
+
+    private long acme;
+
+    @BeforeEach
+    void createContacts() {
+        acme = create("/companies", body("name", "Acme"));
+        create("/contacts", body("firstName", "Ana", "lastName", "Silva", "email", "ana@acme.example",
+                "phone", "+351 912 345 678", "companyId", acme));
+        create("/contacts", body("firstName", "Bruno", "lastName", "Costa", "email", "bruno@globex.example",
+                "phone", "+351 933 000 111"));
+        create("/contacts", body("firstName", "Carla", "lastName", "O'Brien", "email", "carla@initech.example"));
+    }
+
+    private ResponseSpec search(String filter) {
+        return client.get().uri("/contacts/search?filter={filter}", filter).exchange();
+    }
+
+    private List<String> firstNames(String filter) {
+        return search(filter).expectStatus().isOk().expectBody(LIST).returnResult().getResponseBody().stream()
+                .map(contact -> (String) contact.get("firstName")).toList();
+    }
+
+    @ParameterizedTest
+    @CsvSource({"ana, Ana", "COSTA, Bruno", "globex, Bruno", "912 345, Ana"})
+    void matchesAnyField(String filter, String firstName) {
+        assertThat(firstNames(filter)).containsExactly(firstName);
+    }
+
+    @Test
+    void returnsEveryMatchInIdOrder() {
+        assertThat(firstNames(".example")).containsExactly("Ana", "Bruno", "Carla");
+    }
+
+    @Test
+    void returnsWholeContacts() {
+        Map<String, Object> ana = getList("/contacts/search?filter=silva").getFirst();
+
+        assertThat(ana)
+                .containsEntry("firstName", "Ana")
+                .containsEntry("lastName", "Silva")
+                .containsEntry("email", "ana@acme.example")
+                .containsEntry("phone", "+351 912 345 678")
+                .containsEntry("companyId", (int) acme);
+    }
+
+    @Test
+    void returnsAtMostOneHundred() {
+        for (int i = 1; i <= 101; i++) {
+            create("/contacts", body("firstName", "Person" + i, "lastName", "Many", "email", "p" + i + "@many.example"));
+        }
+
+        List<String> found = firstNames("many");
+        assertThat(found).hasSize(100);
+        assertThat(found.getFirst()).isEqualTo("Person1");
+    }
+
+    @Test
+    void noMatch() {
+        assertThat(firstNames("zoe")).isEmpty();
+    }
+
+
+    @Test
+    void blankFilter() {
+        assertThat(badInputFields(search(" "))).containsExactly("filter");
+        assertThat(badInputFields(send(HttpMethod.GET, "/contacts/search", null))).containsExactly("filter");
+    }
+}
