@@ -0,0 +1,28 @@
+package com.example.samplecrm;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import org.junit.jupiter.api.Test;
+
+class ContactCountApiTest extends ApiTestBase {
+
+    private void contact(String firstName, Long companyId) {
+        create("/contacts", body("firstName", firstName, "lastName", "Silva",
+                "email", firstName.toLowerCase() + "@example.org", "companyId", companyId));
+    }
+
+    @Test
+    void countsAllContacts() {
+        long acme = create("/companies", body("name", "Acme"));
+        contact("Ana", acme);
+        contact("Bruno", acme);
+        contact("Carla", null);
+
+        assertThat(get("/contacts/count")).containsEntry("count", 3);
+    }
+
+    @Test
+    void noContacts() {
+        assertThat(get("/contacts/count")).containsEntry("count", 0);
+    }
+}
