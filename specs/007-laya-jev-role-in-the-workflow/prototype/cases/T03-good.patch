new file mode 100644
index 0000000..f6b2172
--- /dev/null
+++ b/src/test/java/com/example/samplecrm/DealStageApiTest.java
@@ -0,0 +1,99 @@
+package com.example.samplecrm;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.util.Map;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.CsvSource;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.MediaType;
+
+class DealStageApiTest extends ApiTestBase {
+
+    private long acme;
+
+    @BeforeEach
+    void createCompany() {
+        acme = create("/companies", body("name", "Acme"));
+    }
+
+    private long deal() {
+        return create("/deals", body("title", "Annual renewal", "amount", 100, "companyId", acme));
+    }
+
+    /** A new deal moved along the allowed path until it reaches {@code stage}. */
+    private long dealAt(String stage) {
+        long id = deal();
+        if (!stage.equals("LEAD")) {
+            put("/deals/" + id + "/stage", body("stage", "QUALIFIED"));
+        }
+        if (stage.equals("WON") || stage.equals("LOST")) {
+            put("/deals/" + id + "/stage", body("stage", stage));
+        }
+        return id;
+    }
+
+    @Test
+    void newDealIsLead() {
+        long id = deal();
+
+        assertThat(get("/deals/" + id)).containsEntry("stage", "LEAD");
+    }
+
+    @ParameterizedTest
+    @CsvSource({"LEAD, QUALIFIED", "QUALIFIED, WON", "QUALIFIED, LOST"})
+    void allowedTransition(String from, String to) {
+        long id = dealAt(from);
+
+        assertThat(put("/deals/" + id + "/stage", body("stage", to))).containsEntry("stage", to);
+        assertThat(get("/deals/" + id)).containsEntry("stage", to);
+    }
+
+    @ParameterizedTest
+    @CsvSource({
+        "LEAD, LEAD", "LEAD, WON", "LEAD, LOST",
+        "QUALIFIED, LEAD", "QUALIFIED, QUALIFIED",
+        "WON, LEAD", "WON, QUALIFIED", "WON, WON", "WON, LOST",
+        "LOST, LEAD", "LOST, QUALIFIED", "LOST, WON", "LOST, LOST"})
+    void invalidTransitionIsConflict(String from, String to) {
+        long id = dealAt(from);
+
+        Map<String, Object> problem = json(send(HttpMethod.PUT, "/deals/" + id + "/stage", body("stage", to))
+                .expectStatus().isEqualTo(409)
+                .expectHeader().contentTypeCompatibleWith(MediaType.APPLICATION_PROBLEM_JSON));
+        assertThat(problem).containsEntry("status", 409);
+        assertThat(get("/deals/" + id)).containsEntry("stage", from);
+    }
+
+    @Test
+    void unknownStage() {
+        long id = deal();
+
+        assertThat(badInputFields(send(HttpMethod.PUT, "/deals/" + id + "/stage", body("stage", "CLOSED"))))
+                .containsExactly("stage");
+        assertThat(get("/deals/" + id)).containsEntry("stage", "LEAD");
+    }
+
+    @Test
+    void missingStage() {
+        long id = deal();
+
+        assertThat(badInputFields(send(HttpMethod.PUT, "/deals/" + id + "/stage", body()))).containsExactly("stage");
+    }
+
+    @Test
+    void unknownDeal() {
+        assertNotFound(HttpMethod.PUT, "/deals/999/stage", body("stage", "QUALIFIED"));
+    }
+
+    @Test
+    void updateKeepsStage() {
+        long id = dealAt("QUALIFIED");
+
+        put("/deals/" + id, body("title", "Two-year renewal", "amount", 200, "companyId", acme));
+
+        assertThat(get("/deals/" + id)).containsEntry("title", "Two-year renewal").containsEntry("stage", "QUALIFIED");
+    }
+}
