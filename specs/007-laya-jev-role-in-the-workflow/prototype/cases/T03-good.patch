@@ -0,0 +1,18 @@
+package com.example.samplecrm.deal;
+
+/** Where a deal is in the sales process. A deal starts as a lead; won and lost deals are closed. */
+public enum DealStage {
+    LEAD,
+    QUALIFIED,
+    WON,
+    LOST;
+
+    /** Whether a deal at this stage may move to {@code next}. */
+    boolean canMoveTo(DealStage next) {
+        return switch (this) {
+            case LEAD -> next == QUALIFIED;
+            case QUALIFIED -> next == WON || next == LOST;
+            case WON, LOST -> false;
+        };
+    }
+}
