diff --git a/src/main/java/com/example/samplecrm/validation/RequestValidator.java b/src/main/java/com/example/samplecrm/validation/RequestValidator.java
new file mode 100644
index 0000000..af12b6a
--- /dev/null
+++ b/src/main/java/com/example/samplecrm/validation/RequestValidator.java
@@ -0,0 +1,109 @@
+package com.example.samplecrm.validation;
+
+import com.example.samplecrm.api.BadInputException;
+import com.example.samplecrm.api.FieldErrorItem;
+import com.example.samplecrm.company.CompanyRepository;
+import com.example.samplecrm.company.CompanyRequest;
+import com.example.samplecrm.contact.ContactRepository;
+import com.example.samplecrm.contact.ContactRequest;
+import com.example.samplecrm.deal.DealRequest;
+import java.math.BigDecimal;
+import java.util.ArrayList;
+import java.util.List;
+import org.springframework.stereotype.Component;
+
+/**
+ * The validation rules for create and update requests, in one place. Each method throws a
+ * {@link BadInputException} naming every wrong field, or returns when the request is valid.
+ */
+@Component
+public class RequestValidator {
+
+    private static final String EMAIL = "[^@\\s]+@[^@\\s]+\\.[^@\\s]+";
+
+    private final CompanyRepository companies;
+    private final ContactRepository contacts;
+
+    RequestValidator(CompanyRepository companies, ContactRepository contacts) {
+        this.companies = companies;
+        this.contacts = contacts;
+    }
+
+    public void validate(CompanyRequest request) {
+        List<FieldErrorItem> errors = new ArrayList<>();
+        requiredText(errors, "name", request.name(), 200);
+        optionalText(errors, "website", request.website(), 500);
+        BadInputException.throwIfAny(errors);
+    }
+
+    public void validate(ContactRequest request) {
+        List<FieldErrorItem> errors = new ArrayList<>();
+        requiredText(errors, "firstName", request.firstName(), 100);
+        requiredText(errors, "lastName", request.lastName(), 100);
+        if (requiredText(errors, "email", request.email(), 254) && !request.email().matches(EMAIL)) {
+            errors.add(new FieldErrorItem("email", "must be a well-formed email address"));
+        }
+        optionalText(errors, "phone", request.phone(), 50);
+        companyExists(errors, request.companyId());
+        BadInputException.throwIfAny(errors);
+    }
+
+    /** A new deal must name its company. */
+    public void validateNew(DealRequest request) {
+        validate(request, true);
+    }
+
+    /** An updated deal may leave its company empty. */
+    public void validateUpdate(DealRequest request) {
+        validate(request, false);
+    }
+
+    private void validate(DealRequest request, boolean companyRequired) {
+        List<FieldErrorItem> errors = new ArrayList<>();
+        requiredText(errors, "title", request.title(), 200);
+        amount(errors, request.amount());
+        if (companyRequired && request.companyId() == null) {
+            errors.add(new FieldErrorItem("companyId", "must not be null"));
+        }
+        companyExists(errors, request.companyId());
+        if (request.mainContactId() != null && !contacts.existsById(request.mainContactId())) {
+            errors.add(new FieldErrorItem("mainContactId", "contact " + request.mainContactId() + " does not exist"));
+        }
+        BadInputException.throwIfAny(errors);
+    }
+
+    /** Adds an error when {@code value} is blank or too long; returns whether it was valid. */
+    private static boolean requiredText(List<FieldErrorItem> errors, String field, String value, int maxLength) {
+        if (value == null || value.isBlank()) {
+            errors.add(new FieldErrorItem(field, "must not be blank"));
+            return false;
+        }
+        if (value.length() > maxLength) {
+            errors.add(new FieldErrorItem(field, "must be at most " + maxLength + " characters"));
+            return false;
+        }
+        return true;
+    }
+
+    private static void optionalText(List<FieldErrorItem> errors, String field, String value, int maxLength) {
+        if (value != null && value.length() > maxLength) {
+            errors.add(new FieldErrorItem(field, "must be at most " + maxLength + " characters"));
+        }
+    }
+
+    private static void amount(List<FieldErrorItem> errors, BigDecimal amount) {
+        if (amount == null) {
+            errors.add(new FieldErrorItem("amount", "must not be null"));
+        } else if (amount.signum() < 0) {
+            errors.add(new FieldErrorItem("amount", "must be greater than or equal to 0"));
+        } else if (amount.scale() > 2 || amount.precision() - amount.scale() > 13) {
+            errors.add(new FieldErrorItem("amount", "must have at most 13 integer and 2 fraction digits"));
+        }
+    }
+
+    private void companyExists(List<FieldErrorItem> errors, Long companyId) {
+        if (companyId != null && !companies.existsById(companyId)) {
+            errors.add(new FieldErrorItem("companyId", "company " + companyId + " does not exist"));
+        }
+    }
+}
