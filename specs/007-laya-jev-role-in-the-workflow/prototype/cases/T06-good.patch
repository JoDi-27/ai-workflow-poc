@@ -0,0 +1,63 @@
+package com.example.samplecrm;
+
+import static org.assertj.core.api.Assertions.assertThat;
+
+import java.util.Map;
+import org.junit.jupiter.api.BeforeEach;
+import org.junit.jupiter.api.Test;
+import org.junit.jupiter.params.ParameterizedTest;
+import org.junit.jupiter.params.provider.ValueSource;
+import org.springframework.http.HttpMethod;
+import org.springframework.http.MediaType;
+
+class ContactDuplicateApiTest extends ApiTestBase {
+
+    private long ana;
+
+    @BeforeEach
+    void createAna() {
+        ana = create("/contacts", contact("Ana", "ana@acme.example"));
+    }
+
+    private static Map<String, Object> contact(String firstName, String email) {
+        return body("firstName", firstName, "lastName", "Silva", "email", email);
+    }
+
+    private void assertConflict(Map<String, Object> request) {
+        Map<String, Object> problem = json(send(HttpMethod.POST, "/contacts", request)
+                .expectStatus().isEqualTo(409)
+                .expectHeader().contentTypeCompatibleWith(MediaType.APPLICATION_PROBLEM_JSON));
+        assertThat(problem).containsEntry("status", 409);
+    }
+
+    @Test
+    void sameEmailIsRejected() {
+        assertConflict(contact("Ana Maria", "ana@acme.example"));
+
+        assertThat(count("contacts")).isEqualTo(1);
+        assertThat(get("/contacts/" + ana)).containsEntry("firstName", "Ana");
+    }
+
+    @ParameterizedTest
+    @ValueSource(strings = {"ANA@ACME.EXAMPLE", "Ana@Acme.Example", " ana@acme.example", "ana@acme.example  ",
+            "\tAna@acme.EXAMPLE "})
+    void emailDifferingInCaseOrWhitespaceIsRejected(String email) {
+        assertConflict(contact("Ana Maria", email));
+
+        assertThat(count("contacts")).isEqualTo(1);
+    }
+
+    @Test
+    void existingEmailWithDifferentCaseIsMatched() {
+        create("/contacts", contact("Bruno", " Bruno@Example.org "));
+
+        assertConflict(contact("Bruno", "bruno@example.org"));
+    }
+
+    @Test
+    void differentEmailIsAccepted() {
+        create("/contacts", contact("Bruno", "bruno@acme.example"));
+
+        assertThat(count("contacts")).isEqualTo(2);
+    }
+}
