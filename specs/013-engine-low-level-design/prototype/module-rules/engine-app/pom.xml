<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <parent>
    <groupId>spike013</groupId>
    <artifactId>module-rules</artifactId>
    <version>0</version>
  </parent>
  <artifactId>engine-app</artifactId>
  <dependencies>
    <dependency><groupId>spike013</groupId><artifactId>engine-ports-in</artifactId></dependency>
    <dependency><groupId>spike013</groupId><artifactId>engine-ports-out</artifactId></dependency>
    <dependency><groupId>spike013</groupId><artifactId>engine-core</artifactId></dependency>
    <dependency><groupId>spike013</groupId><artifactId>driver-api</artifactId></dependency>
    <dependency><groupId>spike013</groupId><artifactId>scheduler</artifactId></dependency>
    <dependency><groupId>spike013</groupId><artifactId>runner-client</artifactId></dependency>
    <dependency><groupId>spike013</groupId><artifactId>systemone</artifactId></dependency>
    <dependency><groupId>spike013</groupId><artifactId>broker-client</artifactId></dependency>
    <dependency><groupId>org.springframework</groupId><artifactId>spring-context</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot</artifactId></dependency>
    <dependency><groupId>org.springframework.boot</groupId><artifactId>spring-boot-autoconfigure</artifactId></dependency>
    <dependency><groupId>com.tngtech.archunit</groupId><artifactId>archunit</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.tngtech.archunit</groupId><artifactId>archunit-junit5-api</artifactId><scope>test</scope></dependency>
    <dependency><groupId>com.tngtech.archunit</groupId><artifactId>archunit-junit5-engine</artifactId><scope>test</scope></dependency>
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <executions>
          <execution>
            <id>analyze</id>
            <configuration>
              <!-- engine-app wires modules by component scan, so no bytecode references them,
                   and the JUnit engine is runtime-only. Everything else is still checked. -->
              <ignoredUnusedDeclaredDependencies>
                <ignoredUnusedDeclaredDependency>spike013:*</ignoredUnusedDeclaredDependency>
                <ignoredUnusedDeclaredDependency>com.tngtech.archunit:archunit-junit5-engine</ignoredUnusedDeclaredDependency>
              </ignoredUnusedDeclaredDependencies>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
