<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>
  <!-- Throwaway module-rules prototype for spike 013. Not production code. -->
  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.1.1</version>
    <relativePath/>
  </parent>
  <groupId>spike013</groupId>
  <artifactId>module-rules</artifactId>
  <version>0</version>
  <packaging>pom</packaging>
  <properties>
    <java.version>25</java.version>
    <archunit.version>1.5.1</archunit.version>
    <gcp-libraries-bom.version>26.90.0</gcp-libraries-bom.version>
  </properties>
  <modules>
    <module>engine-ports-in</module>
    <module>engine-ports-out</module>
    <module>engine-core</module>
    <module>driver-api</module>
    <module>scheduler</module>
    <module>runner-client</module>
    <module>systemone</module>
    <module>broker-client</module>
    <module>engine-app</module>
  </modules>
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>com.google.cloud</groupId>
        <artifactId>libraries-bom</artifactId>
        <version>${gcp-libraries-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
      <dependency><groupId>spike013</groupId><artifactId>engine-ports-in</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>spike013</groupId><artifactId>engine-ports-out</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>spike013</groupId><artifactId>engine-core</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>spike013</groupId><artifactId>driver-api</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>spike013</groupId><artifactId>scheduler</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>spike013</groupId><artifactId>runner-client</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>spike013</groupId><artifactId>systemone</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>spike013</groupId><artifactId>broker-client</artifactId><version>${project.version}</version></dependency>
      <dependency><groupId>com.tngtech.archunit</groupId><artifactId>archunit</artifactId><version>${archunit.version}</version></dependency>
      <dependency><groupId>com.tngtech.archunit</groupId><artifactId>archunit-junit5-api</artifactId><version>${archunit.version}</version></dependency>
      <dependency><groupId>com.tngtech.archunit</groupId><artifactId>archunit-junit5-engine</artifactId><version>${archunit.version}</version></dependency>
    </dependencies>
  </dependencyManagement>
  <build>
    <plugins>
      <!-- Every module: declared dependencies must equal used dependencies. -->
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-dependency-plugin</artifactId>
        <version>3.11.0</version>
        <executions>
          <execution>
            <id>analyze</id>
            <goals><goal>analyze-only</goal></goals>
            <configuration>
              <failOnWarning>true</failOnWarning>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
