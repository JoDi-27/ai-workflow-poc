<?xml version="1.0" encoding="UTF-8"?>
<!-- Project settings: plain Maven Central, bypassing any mirror in ~/.m2/settings.xml (spike 013).
     Read through .mvn/maven.config, so run Maven from engine/ (MNG-6762). -->
<settings xmlns="http://maven.apache.org/SETTINGS/1.2.0">
  <mirrors>
    <mirror>
      <id>central-direct</id>
      <mirrorOf>*</mirrorOf>
      <url>https://repo.maven.apache.org/maven2</url>
    </mirror>
  </mirrors>
</settings>
