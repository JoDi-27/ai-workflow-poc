#!/usr/bin/env bash
# Git commit-msg hook: reject a message whose first line does not start with `[NNN]`, `[NNN] Tn`, or `[meta]`.
# Same rule as .claude/hooks/pre-commit-message.sh, but for every commit, not only Claude's.
# Enable once per clone: git config core.hooksPath .githooks
msg=$(grep -v '^#' "$1" | grep -m1 -v '^[[:space:]]*$')

# Commits git writes itself, and fixups that a rebase will squash away.
if printf '%s' "$msg" | grep -Eq '^(Merge |Revert "|fixup! |squash! |amend! )'; then exit 0; fi
if printf '%s' "$msg" | grep -Eq '^(\[meta\]|\[[0-9]{3}\]( T[0-9]+)?)( |$)'; then exit 0; fi

echo "Commit message must start with the spec ID, e.g. '[003] T2 Add run state table', '[003] Close spike', or '[meta] Fix hook' for housekeeping with no spec. See CONTRIBUTING.md. Got: $msg" >&2
exit 1
